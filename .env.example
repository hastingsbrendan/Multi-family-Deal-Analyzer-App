VITE_SB_URL=https://your-project.supabase.co
VITE_SB_ANON_KEY=your-anon-key
VITE_GMAPS_KEY=your-google-maps-key   # browser key: restrict to your domains in Google Cloud

# Server-side secrets live in Cloudflare Pages (Settings → Variables and Secrets), never
# in VITE_* vars: RENTCAST_KEY, GMAPS_KEY, FRED_API_KEY, BLS_API_KEY, SUPABASE_URL,
# SUPABASE_ANON_KEY. They are read by the proxies in functions/api/.

# Environment flag — controls dev-only features (e.g. Loan Type tab)
# Set to "development" in Cloudflare Pages env vars for the `develop` branch preview.
# Leave unset or set to "production" for the main/production deployment.
VITE_APP_ENV=development
